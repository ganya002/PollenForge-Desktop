# Copy to ~/.config/nexum/config.json or set via Settings UI (Cmd+,)
# Never commit real keys — this file is just a template.

# Pollinations (free tier works without key, but add for higher limits)
# POLLINATIONS_API_KEY=sk_...

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google
# GOOGLE_API_KEY=AIza...
